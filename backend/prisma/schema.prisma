generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SUPPLIER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum CertificationType {
  AS9100
  ISO9001
}

enum SupplierDocumentType {
  CAPABILITY_PROFILE
  BROCHURE
}

enum RfqStatus {
  DRAFT
  SENT
  QUOTES_RECEIVED
  AWARDED
  CLOSED
}

model User {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  password  String   @db.VarChar(255)
  role      UserRole @default(SUPPLIER)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplierProfile SupplierProfile?
  requestedRfqs   Rfq[]
  rfqAwards       RfqAward[]

  @@map("users")
}

model SupplierProfile {
  id                    String   @id @default(uuid()) @db.Char(36)
  userId                String   @unique @map("user_id") @db.Char(36)
  companyName           String   @map("company_name") @db.VarChar(255)
  contactPerson         String   @map("contact_person") @db.VarChar(255)
  phone                 String?  @db.VarChar(50)
  address               String?  @db.Text
  tradeLicenseNumber    String?  @map("trade_license_number") @db.VarChar(255)
  countryOfRegistration String?  @map("country_of_registration") @db.VarChar(120)
  websiteUrl            String?  @map("website_url") @db.VarChar(500)
  comments              String?  @db.Text
  itarRegistered        Boolean  @default(false) @map("itar_registered")
  status                Status   @default(ACTIVE)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  services       SupplierService[]
  certifications SupplierCertification[]
  documents      SupplierDocument[]
  rfqInvites     RfqInvite[]
  rfqQuotes      RfqQuote[]
  rfqAwards      RfqAward[]

  @@map("supplier_profiles")
}

model Service {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  suppliers    SupplierService[]
  rfqProcesses RfqProcessService[]
  rfqQuotes    RfqQuote[]
  rfqAwards    RfqAward[]

  @@map("services")
}

model SupplierService {
  id         String   @id @default(uuid()) @db.Char(36)
  supplierId String   @map("supplier_id") @db.Char(36)
  serviceId  String   @map("service_id") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at")

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([supplierId, serviceId])
  @@map("supplier_services")
}

model SupplierCertification {
  id         String            @id @default(uuid()) @db.Char(36)
  supplierId String            @map("supplier_id") @db.Char(36)
  type       CertificationType
  certified  Boolean           @default(false)
  expiryDate DateTime?         @map("expiry_date")
  fileName   String?           @map("file_name") @db.VarChar(255)
  fileKey    String?           @map("file_key") @db.VarChar(500)
  mimeType   String?           @map("mime_type") @db.VarChar(120)
  fileSize   Int?              @map("file_size")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, type])
  @@map("supplier_certifications")
}

model SupplierDocument {
  id         String               @id @default(uuid()) @db.Char(36)
  supplierId String               @map("supplier_id") @db.Char(36)
  docType    SupplierDocumentType @map("doc_type")
  fileName   String               @map("file_name") @db.VarChar(255)
  fileKey    String               @map("file_key") @db.VarChar(500)
  mimeType   String?              @map("mime_type") @db.VarChar(120)
  fileSize   Int?                 @map("file_size")
  uploadedAt DateTime             @default(now()) @map("uploaded_at")

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_documents")
}

model Client {
  id            String   @id @default(uuid()) @db.Char(36)
  companyName   String   @map("company_name") @db.VarChar(255)
  contactPerson String   @map("contact_person") @db.VarChar(255)
  email         String   @unique @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  address       String?  @db.Text
  status        Status   @default(ACTIVE)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("clients")
}

model Rfq {
  id                          String    @id @default(uuid()) @db.Char(36)
  rfqNumber                   String    @unique @map("rfq_number") @db.VarChar(32)
  title                       String    @db.VarChar(255)
  requestedById               String    @map("requested_by_id") @db.Char(36)
  clientProjectName           String    @map("client_project_name") @db.VarChar(255)
  dateCreated                 DateTime  @default(now()) @map("date_created")
  quoteDueDate                DateTime  @map("quote_due_date") @db.Date
  requiredDeliveryDate        DateTime  @map("required_delivery_date") @db.Date
  partName                    String    @map("part_name") @db.VarChar(255)
  partNumber                  String    @map("part_number") @db.VarChar(255)
  revisionLevel               String?   @map("revision_level") @db.VarChar(50)
  materialSpecification       String?   @map("material_specification") @db.Text
  quantity                    Decimal   @db.Decimal(14, 3)
  unitOfMeasure               String    @map("unit_of_measure") @db.VarChar(32)
  specialProcesses            Json      @default("[]") @map("special_processes")
  toleranceNotes              String?   @map("tolerance_notes") @db.Text
  requiredCertifications      Json      @default("[]") @map("required_certifications")
  itarExportControl           Boolean   @map("itar_export_control")
  countryOfOriginRestriction  String?   @map("country_of_origin_restriction") @db.VarChar(120)
  incoterms                   String    @db.VarChar(32)
  targetBudgetaryPrice        Decimal?  @map("target_budgetary_price") @db.Decimal(14, 2)
  paymentTerms                String?   @map("payment_terms") @db.VarChar(64)
  currency                    String    @db.VarChar(8)
  quotesRequired              Int?      @map("quotes_required")
  status                      RfqStatus @default(DRAFT)
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  requestedBy     User                @relation(fields: [requestedById], references: [id])
  processServices RfqProcessService[]
  documents       RfqDocument[]
  invites         RfqInvite[]
  quotes          RfqQuote[]
  awards          RfqAward[]

  @@index([status])
  @@index([quoteDueDate])
  @@map("rfqs")
}

model RfqProcessService {
  id        String   @id @default(uuid()) @db.Char(36)
  rfqId     String   @map("rfq_id") @db.Char(36)
  serviceId String   @map("service_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  rfq     Rfq     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([rfqId, serviceId])
  @@map("rfq_process_services")
}

model RfqDocument {
  id         String   @id @default(uuid()) @db.Char(36)
  rfqId      String   @map("rfq_id") @db.Char(36)
  fileName   String   @map("file_name") @db.VarChar(255)
  fileKey    String   @map("file_key") @db.VarChar(500)
  mimeType   String?  @map("mime_type") @db.VarChar(120)
  fileSize   Int?     @map("file_size")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@map("rfq_documents")
}

model RfqInvite {
  id         String   @id @default(uuid()) @db.Char(36)
  rfqId      String   @map("rfq_id") @db.Char(36)
  supplierId String   @map("supplier_id") @db.Char(36)
  included   Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  rfq      Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([rfqId, supplierId])
  @@map("rfq_invites")
}

model RfqQuote {
  id         String   @id @default(uuid()) @db.Char(36)
  rfqId      String   @map("rfq_id") @db.Char(36)
  supplierId String   @map("supplier_id") @db.Char(36)
  serviceId  String   @map("service_id") @db.Char(36)
  price      Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  rfq      Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([rfqId, supplierId, serviceId])
  @@index([rfqId, serviceId])
  @@map("rfq_quotes")
}

model RfqAward {
  id          String   @id @default(uuid()) @db.Char(36)
  rfqId       String   @map("rfq_id") @db.Char(36)
  serviceId   String   @map("service_id") @db.Char(36)
  supplierId  String   @map("supplier_id") @db.Char(36)
  awardedById String   @map("awarded_by_id") @db.Char(36)
  awardedAt   DateTime @default(now()) @map("awarded_at")

  rfq       Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  service   Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  supplier  SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  awardedBy User            @relation(fields: [awardedById], references: [id])

  @@unique([rfqId, serviceId])
  @@map("rfq_awards")
}
