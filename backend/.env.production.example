NODE_ENV=production
PORT=3000

# Matches root .env: mysql://<MYSQL_USER>:<MYSQL_PASSWORD>@mysql:3306/<MYSQL_DATABASE>
DATABASE_URL=mysql://fabnet:CHANGE_ME_DB_PASSWORD@mysql:3306/fabnet

# Generate a strong key: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARACTERS_LONG
JWT_EXPIRES_IN=8h

# Domain of the frontend management portal
CORS_ORIGIN=https://panel.fabnetsystems.com

LOG_LEVEL=info
BCRYPT_ROUNDS=12

# Vultr Object Storage (S3-compatible) — supplier certs / documents
S3_ENDPOINT=https://ewr1.vultrobjects.com
S3_REGION=ewr1
S3_BUCKET=fabnet-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Microsoft Graph mail (RFQ invite emails)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
FROM_EMAIL=info@fabnetsystems.com

FABNET_COMPANY_NAME=FabNet Systems
FABNET_WEBSITE=www.fabnetsystems.com
FABNET_CONTACT_NAME=Sales Team
FABNET_QUOTE_VALIDITY_DAYS=30
