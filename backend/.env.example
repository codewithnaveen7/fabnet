NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://fabnet:fabnet_dev@localhost:3306/fabnet_dev
JWT_SECRET=your-secret-min-32-characters-long
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:3002
LOG_LEVEL=debug
BCRYPT_ROUNDS=10

# Vultr Object Storage (S3-compatible) — supplier certs / documents
S3_ENDPOINT=https://ewr1.vultrobjects.com
S3_REGION=ewr1
S3_BUCKET=fabnet-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: public/CDN base URL for the bucket
# S3_PUBLIC_BASE_URL=https://fabnet-uploads.ewr1.vultrobjects.com

# Microsoft Graph mail (RFQ invite emails)
# Azure App Registration needs Mail.Send (Application) + admin consent
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
FROM_EMAIL=admin@fabnetsystems.com
