# Development / local compose: build kdesigns and serve with nginx (CORS enabled)
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run sass && npm run build

FROM nginx:alpine

COPY web_server_conf/conf.d/ /etc/nginx/conf.d/
COPY --from=builder /app/dist/ /usr/share/nginx/html/

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
