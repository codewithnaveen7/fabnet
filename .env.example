# Copy to .env and adjust for docker compose (dev: docker-compose.yml, prod: docker-compose.prod.yml)

# MySQL (used by compose mysql service)
# Use single quotes if password contains $ — Docker Compose treats $ as variable substitution.
MYSQL_ROOT_PASSWORD='changeme_root'
MYSQL_DATABASE=fabnet_dev
MYSQL_USER=fabnet
MYSQL_PASSWORD='changeme_dev'

# Production overrides (docker-compose.prod.yml / docker-compose.prod.pull.yml)
# MYSQL_DATABASE=fabnet

# Docker Hub (production pull deploy — docker-compose.prod.pull.yml)
DOCKER_REGISTRY=naveen2202
IMAGE_TAG=latest

# Frontend build args (used by scripts/docker-build-push.sh when building images locally)
# React app URL: https://panel.fabnetsystems.com
REACT_APP_API_BASE_URL=https://api.fabnetsystems.com/api
REACT_APP_KDESIGNS_REMOTE_ENTRY_URL=https://cdn.fabnetsystems.com/kdesigns/remoteEntry.js

# Public domains (used by nginx proxy + Let's Encrypt on server)
PANEL_DOMAIN=panel.fabnetsystems.com
API_DOMAIN=api.fabnetsystems.com
CDN_DOMAIN=cdn.fabnetsystems.com
LETSENCRYPT_EMAIL=you@fabnetsystems.com
